# Generated by Matugen — do not edit manually.
#
# Same derivation as the kitty palette: three scheme hues (red, blue,
# magenta) plus their complements (green, yellow, cyan), all normalised
# to one lightness so shell text is never washed-out white.
# In light mode the pull is dropped (the light roles already read dark
# on a light background); inverted slots are forced down to 42.
#
# `set -g` (session scope) instead of `set -U`: this file is re-sourced
# by fish_prompt.fish on every prompt, and universal variables would
# rewrite ~/.config/fish/fish_variables each time. Every shell sources
# this file itself, so nothing is lost.
#
# The two prompt colours (user + path) have their hue pinned: matugen
# has no "clamp hue" filter, so the only way to guarantee the prompt is
# never green is to set the hue outright. Saturation and lightness still
# come from the wallpaper, so they keep adapting to it.
set -g fish_color_normal "{{colors.on_surface.default.hex}}"
set -g fish_color_command "<* if {{ is_dark_mode }} *>{{colors.primary.default.hex | set_lightness: 68.0}}<* else *>{{colors.primary.default.hex}}<* endif *>"
set -g fish_color_keyword "<* if {{ is_dark_mode }} *>{{colors.tertiary.default.hex | set_lightness: 76.0}}<* else *>{{colors.tertiary.default.hex}}<* endif *>"
set -g fish_color_quote "<* if {{ is_dark_mode }} *>{{colors.primary.default.hex | invert | set_lightness: 72.0}}<* else *>{{colors.primary.default.hex | invert | set_lightness: 42.0}}<* endif *>"
set -g fish_color_redirection "<* if {{ is_dark_mode }} *>{{colors.tertiary.default.hex | invert | set_lightness: 68.0}}<* else *>{{colors.tertiary.default.hex | invert | set_lightness: 42.0}}<* endif *>"
set -g fish_color_end "<* if {{ is_dark_mode }} *>{{colors.tertiary.default.hex | invert | set_lightness: 68.0}}<* else *>{{colors.tertiary.default.hex | invert | set_lightness: 42.0}}<* endif *>"
set -g fish_color_error "<* if {{ is_dark_mode }} *>{{colors.secondary.default.hex | set_hue: 5.0 | set_lightness: 70.0}}<* else *>{{colors.secondary.default.hex | set_hue: 5.0}}<* endif *>"
set -g fish_color_param "<* if {{ is_dark_mode }} *>{{colors.secondary.default.hex | set_hue: 160.0 | set_lightness: 70.0}}<* else *>{{colors.secondary.default.hex | set_hue: 160.0}}<* endif *>"
set -g fish_color_comment "{{colors.on_surface_variant.default.hex}}"
set -g fish_color_selection --background={{colors.primary_container.default.hex}}
set -g fish_color_operator "<* if {{ is_dark_mode }} *>{{colors.tertiary.default.hex | set_lightness: 76.0}}<* else *>{{colors.tertiary.default.hex}}<* endif *>"
set -g fish_color_escape "<* if {{ is_dark_mode }} *>{{colors.primary.default.hex | invert | set_lightness: 72.0}}<* else *>{{colors.primary.default.hex | invert | set_lightness: 42.0}}<* endif *>"
set -g fish_color_autosuggestion "{{colors.outline.default.hex}}"
set -g fish_color_cancel "<* if {{ is_dark_mode }} *>{{colors.secondary.default.hex | set_hue: 5.0 | set_lightness: 70.0}}<* else *>{{colors.secondary.default.hex | set_hue: 5.0}}<* endif *>"
set -g fish_color_cwd "{{colors.primary.default.hex | to_color | set_hue: 222.0}}"
set -g fish_color_user "{{colors.secondary.default.hex | set_hue: 5.0 | to_color | set_hue: 330.0}}"
set -g fish_color_host "<* if {{ is_dark_mode }} *>{{colors.tertiary.default.hex | set_lightness: 76.0}}<* else *>{{colors.tertiary.default.hex}}<* endif *>"
set -g fish_color_valid_path --underline

set -g fish_pager_color_progress "{{colors.outline.default.hex}}"
set -g fish_pager_color_prefix "<* if {{ is_dark_mode }} *>{{colors.primary.default.hex | set_lightness: 68.0}}<* else *>{{colors.primary.default.hex}}<* endif *>"
set -g fish_pager_color_completion "{{colors.on_surface.default.hex}}"
set -g fish_pager_color_description "{{colors.on_surface_variant.default.hex}}"
set -g fish_pager_color_selected_background --background={{colors.primary_container.default.hex}}
