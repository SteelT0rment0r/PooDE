* {
    /* Same base expression as bar-background in
       desktop-templates/waybar.css, but two lightness points deeper:
       a large flat window reads lighter than the bar's small shadowed
       circles when the values are equal. If waybar.css changes, keep
       this offset (dark bar 6.5 / rofi 4.5, alt 11.0 / 9.0; light
       bar 96 / rofi 94, alt 91 / 89). The scheme's own saturation is
       kept: an absolute set_saturation tints neutral schemes red,
       since grey has hue 0.

       on-gradient is the text colour on the wallpaper-gradient
       highlights (element selected): those gradients stay light in
       both modes, so it always ends up dark. */
    background: <* if {{ is_dark_mode }} *>{{colors.background.default.hex | set_lightness: 4.5}}<* else *>{{colors.background.default.hex | set_lightness: 94.0}}<* endif *>;
    background-alt: <* if {{ is_dark_mode }} *>{{colors.background.default.hex | set_lightness: 9.0}}<* else *>{{colors.background.default.hex | set_lightness: 89.0}}<* endif *>;
    foreground: {{colors.on_surface.default.hex}};
    on-gradient: {{colors.background.default.hex | set_lightness: 4.5}};
    blue: {{accents.secondary.hex}};
    cyan: {{accents.secondary.hex}};
    selected: {{accents.secondary.hex}};
    active: {{accents.secondary.hex}};
    urgent: <* if {{ is_dark_mode }} *>{{colors.secondary.default.hex | set_hue: 5.0 | set_lightness: 76.0}}<* else *>{{colors.secondary.default.hex | set_hue: 5.0}}<* endif *>;
    muted: {{accents.muted.hex}};

    /* Neon text accents — same six-hue derivation as desktop-templates/
       waybar.css (@neon-*) so rofi rows can match the bar's per-widget
       vivid hues (network = cyan, bluetooth = magenta, ...). Derived
       only from scheme-varying roles (colours.error is identical in
       every scheme); see waybar.css for the full rationale. */
    neon-red: <* if {{ is_dark_mode }} *>{{colors.secondary.default.hex | set_hue: 5.0 | set_lightness: 76.0 | saturate: -15.0, "hsl"}}<* else *>{{colors.secondary.default.hex | set_hue: 5.0 | saturate: -15.0, "hsl"}}<* endif *>;
    neon-green: <* if {{ is_dark_mode }} *>{{colors.tertiary.default.hex | invert | set_lightness: 78.0 | saturate: -15.0, "hsl"}}<* else *>{{colors.tertiary.default.hex | invert | set_lightness: 42.0 | saturate: -15.0, "hsl"}}<* endif *>;
    neon-yellow: <* if {{ is_dark_mode }} *>{{colors.primary.default.hex | invert | set_lightness: 80.0 | saturate: -15.0, "hsl"}}<* else *>{{colors.primary.default.hex | invert | set_lightness: 42.0 | saturate: -15.0, "hsl"}}<* endif *>;
    neon-blue: <* if {{ is_dark_mode }} *>{{colors.primary.default.hex | set_lightness: 76.0 | saturate: -15.0, "hsl"}}<* else *>{{colors.primary.default.hex | saturate: -15.0, "hsl"}}<* endif *>;
    neon-magenta: <* if {{ is_dark_mode }} *>{{colors.tertiary.default.hex | set_lightness: 80.0 | saturate: -15.0, "hsl"}}<* else *>{{colors.tertiary.default.hex | saturate: -15.0, "hsl"}}<* endif *>;
    neon-cyan: <* if {{ is_dark_mode }} *>{{colors.secondary.default.hex | set_hue: 160.0 | set_lightness: 74.0 | saturate: -15.0, "hsl"}}<* else *>{{colors.secondary.default.hex | set_hue: 160.0 | saturate: -15.0, "hsl"}}<* endif *>;
}
