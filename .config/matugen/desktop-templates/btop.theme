theme[cached_mid]="{{colors.on_surface.default.hex}}"
theme[cached_end]="{{colors.on_surface.default.hex}}"
theme[available_start]="<* if {{ is_dark_mode }} *>{{colors.primary.default.hex | invert | set_lightness: 80.0}}<* else *>{{colors.primary.default.hex | invert | set_lightness: 42.0}}<* endif *>"
theme[available_mid]="<* if {{ is_dark_mode }} *>{{colors.secondary.default.hex | set_hue: 160.0 | set_lightness: 78.0}}<* else *>{{colors.secondary.default.hex | set_hue: 160.0}}<* endif *>"
