theme[upload_mid]="<* if {{ is_dark_mode }} *>{{colors.primary.default.hex | set_lightness: 76.0}}<* else *>{{colors.primary.default.hex}}<* endif *>"
theme[upload_end]="<* if {{ is_dark_mode }} *>{{colors.secondary.default.hex | set_hue: 5.0 | set_lightness: 76.0}}<* else *>{{colors.secondary.default.hex | set_hue: 5.0}}<* endif *>"
theme[process_start]="<* if {{ is_dark_mode }} *>{{colors.secondary.default.hex | set_hue: 160.0 | set_lightness: 78.0}}<* else *>{{colors.secondary.default.hex | set_hue: 160.0}}<* endif *>"
