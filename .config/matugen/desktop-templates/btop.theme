# btop theme with the shared neon palette - generated by matugen, do not edit.
# Same six-hue derivation as desktop-templates/waybar.css (@neon-*): graph
# gradients run cool -> hot (cyan/yellow/red), boxes use a dim surface tint.
# Mode-conditional lines follow matugen's is_dark_mode: light mode drops
# the lightness pull (light roles already read dark); the selected row
# and meter track mirror up (65 / 86) so their foregrounds stay legible.
theme[main_bg]="{{colors.background.default.hex}}"
theme[main_fg]="{{colors.on_surface.default.hex}}"
theme[title]="{{colors.on_surface.default.hex}}"
theme[hi_fg]="<* if {{ is_dark_mode }} *>{{colors.primary.default.hex | set_lightness: 76.0}}<* else *>{{colors.primary.default.hex}}<* endif *>"
theme[selected_bg]="<* if {{ is_dark_mode }} *>{{colors.on_surface_variant.default.hex | set_lightness: 35.0}}<* else *>{{colors.on_surface_variant.default.hex | set_lightness: 65.0}}<* endif *>"
theme[selected_fg]="{{colors.on_surface.default.hex}}"
theme[inactive_fg]="<* if {{ is_dark_mode }} *>{{colors.on_surface_variant.default.hex | set_lightness: 35.0}}<* else *>{{colors.on_surface_variant.default.hex}}<* endif *>"
theme[graph_text]="{{colors.on_surface.default.hex}}"
theme[meter_bg]="<* if {{ is_dark_mode }} *>{{colors.background.default.hex | set_lightness: 14.0}}<* else *>{{colors.background.default.hex | set_lightness: 86.0}}<* endif *>"
theme[proc_misc]="<* if {{ is_dark_mode }} *>{{colors.primary.default.hex | set_lightness: 76.0}}<* else *>{{colors.primary.default.hex}}<* endif *>"
theme[cpu_box]="<* if {{ is_dark_mode }} *>{{colors.on_surface_variant.default.hex | set_lightness: 35.0}}<* else *>{{colors.on_surface_variant.default.hex}}<* endif *>"
theme[mem_box]="<* if {{ is_dark_mode }} *>{{colors.on_surface_variant.default.hex | set_lightness: 35.0}}<* else *>{{colors.on_surface_variant.default.hex}}<* endif *>"
theme[net_box]="<* if {{ is_dark_mode }} *>{{colors.on_surface_variant.default.hex | set_lightness: 35.0}}<* else *>{{colors.on_surface_variant.default.hex}}<* endif *>"
theme[proc_box]="<* if {{ is_dark_mode }} *>{{colors.on_surface_variant.default.hex | set_lightness: 35.0}}<* else *>{{colors.on_surface_variant.default.hex}}<* endif *>"
theme[div_line]="<* if {{ is_dark_mode }} *>{{colors.on_surface_variant.default.hex | set_lightness: 35.0}}<* else *>{{colors.on_surface_variant.default.hex}}<* endif *>"
theme[temp_start]="<* if {{ is_dark_mode }} *>{{colors.secondary.default.hex | set_hue: 160.0 | set_lightness: 78.0}}<* else *>{{colors.secondary.default.hex | set_hue: 160.0}}<* endif *>"
theme[temp_mid]="<* if {{ is_dark_mode }} *>{{colors.primary.default.hex | invert | set_lightness: 80.0}}<* else *>{{colors.primary.default.hex | invert | set_lightness: 42.0}}<* endif *>"
theme[temp_end]="<* if {{ is_dark_mode }} *>{{colors.primary.default.hex | set_lightness: 76.0}}<* else *>{{colors.primary.default.hex}}<* endif *>"
theme[cpu_start]="{{colors.on_surface.default.hex}}"
theme[cpu_mid]="<* if {{ is_dark_mode }} *>{{colors.secondary.default.hex | set_hue: 160.0 | set_lightness: 78.0}}<* else *>{{colors.secondary.default.hex | set_hue: 160.0}}<* endif *>"
theme[cpu_end]="<* if {{ is_dark_mode }} *>{{colors.primary.default.hex | set_lightness: 76.0}}<* else *>{{colors.primary.default.hex}}<* endif *>"
theme[free_start]="<* if {{ is_dark_mode }} *>{{colors.on_surface_variant.default.hex | set_lightness: 35.0}}<* else *>{{colors.on_surface_variant.default.hex}}<* endif *>"
theme[free_mid]="<* if {{ is_dark_mode }} *>{{colors.secondary.default.hex | set_hue: 160.0 | set_lightness: 78.0}}<* else *>{{colors.secondary.default.hex | set_hue: 160.0}}<* endif *>"
