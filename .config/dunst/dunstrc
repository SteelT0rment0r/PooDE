
[global]
    monitor = 0
    follow = mouse
    width = 340
    height = 180
    origin = top-right
    offset = 12x48
    scale = 0
    notification_limit = 5

    progress_bar = true
    progress_bar_height = 4
    progress_bar_frame_width = 0
    progress_bar_min_width = 0
    progress_bar_max_width = 300

    indicate_hidden = yes
    transparency = 5
    separator_height = 1
    padding = 12
    horizontal_padding = 12
    text_icon_padding = 8

    frame_width = 1
    frame_color = "#2acac4"
    gap_size = 8

    corner_radius = 2
    corners = all

    font = Maple Mono NF 10
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no

    stack_duplicates = true
    hide_duplicate_count = false
    sticky_history = yes
    history_length = 20

    mouse_left_click = close_current
    mouse_middle_click = do_action
    mouse_right_click = close_all

    background = "#0a1117"
    foreground = "#dbe3ed"

[urgency_low]
    background = "#0a1117"
    foreground = "#dbe3ed"
    frame_color = "#2acac4"
    timeout = 5

[urgency_normal]
    background = "#0a1117"
    foreground = "#dbe3ed"
    frame_color = "#2acac4"
    timeout = 8

[urgency_critical]
    background = "#0a1117"
    foreground = "#d7b0ac"
    frame_color = "#d7b0ac"
    timeout = 0

