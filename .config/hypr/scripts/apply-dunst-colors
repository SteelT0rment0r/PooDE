#!/usr/bin/env python3
"""Patch dunst's colours from matugen's rendered dunst-colors.conf.

dunst cannot include another config file, and toggle-focus.sh rewrites the
transparency / corner_radius lines of dunstrc, so a wallpaper change may
only touch the colour lines. This helper rewrites background, foreground
and frame_color per section in place and reloads a running dunst.

Idempotent: values are rewritten from the template output every time, so
running it twice reports no changes the second time.
"""
import re
import subprocess
import sys
from pathlib import Path

COLORS = Path.home() / ".cache/desktop-theme/dunst-colors.conf"
DUNSTRC = Path.home() / ".config/dunst/dunstrc"

if not COLORS.is_file() or not DUNSTRC.is_file():
    sys.exit(0)  # template not rendered yet / no config to patch

values = {}
for line in COLORS.read_text().splitlines():
    m = re.match(r"\s*([a-z_]+)\s*=\s*(#[0-9a-fA-F]{6})\s*$", line)
    if m:
        values[m.group(1)] = m.group(2).lower()

missing = {"background", "foreground", "frame", "critical"} - values.keys()
if missing:
    sys.exit("apply-dunst-colors: missing in template output: " +
             ", ".join(sorted(missing)))

colour_line = re.compile(
    r'^(\s*)(background|foreground|frame_color)(\s*=\s*")#?[0-9a-fA-F]{6}(")')

section = None
changed = 0
out = []
for line in DUNSTRC.read_text().splitlines(keepends=True):
    m = re.match(r"\s*\[([^\]]+)\]", line)
    if m:
        section = m.group(1)

    m = colour_line.match(line.rstrip("\n"))
    if not m:
        out.append(line)
        continue

    indent, key, prefix, suffix = m.groups()
    if key == "frame_color":
        value = values["critical"] if section == "urgency_critical" else values["frame"]
    elif key == "foreground" and section == "urgency_critical":
        value = values["critical"]
    elif key == "foreground":
        value = values["foreground"]
    else:
        value = values["background"]

    ending = "\n" if line.endswith("\n") else ""
    new = f'{indent}{key}{prefix}{value}{suffix}{ending}'
    if new != line:
        changed += 1
    out.append(new)

if changed:
    DUNSTRC.write_text("".join(out))
    # A missing dunst must not break the wallpaper pipeline.
    subprocess.run(["dunstctl", "reload"],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print(f"apply-dunst-colors: {changed} colour lines updated")
