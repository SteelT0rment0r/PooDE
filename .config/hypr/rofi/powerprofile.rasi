configuration {
    show-icons: false;
}

@import "~/.cache/desktop-theme/colors.rasi"
@import "shared/fonts.rasi"

window {
    transparency: "real";
    location: center;
    anchor: center;
    width: 520px;
    border: 0px solid;
    border-radius: 32px;
    border-color: @selected;
    background-color: @background;
}

mainbox {
    spacing: 10px;
    margin: 0px;
    padding: 30px;
    background-color: transparent;
    children: [ "inputbar", "listview" ];
}

inputbar {
    spacing: 10px;
    padding: 0px;
    background-color: transparent;
    text-color: @foreground;
    children: [ "prompt" ];
}

prompt {
    padding: 10px;
    border-radius: 32px;
    background-color: @background-alt;
    text-color: @neon-yellow;
}

listview {
    columns: 3;
    lines: 1;
    spacing: 10px;
    layout: vertical;
    scrollbar: false;
    background-color: transparent;
    dynamic: false;
    fixed-height: true;
    border-radius: 1px;
}

element {
    padding: 20px 10px;
    border: 0px solid;
    border-radius: 32px;
    border-color: @background-alt;
    background-color: @background;
    text-color: @foreground;
    cursor: pointer;
}

element-text {
    font: "Maple Mono NF 12";
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
    horizontal-align: 0.5;
}

element selected.normal {
    background-image: linear-gradient(to right, #90B2CE, #8BAFCD, #86ADCD, #81AACC, #7CA8CB, #77A5CA, #72A3CA);
    background-color: @selected;
    border-color: @active;
    text-color: @on-gradient;
}

element normal.normal {
    background-color: @background;
    text-color: @foreground;
}
