#!/usr/bin/env bash

# Rofi switcher for the colour mode (matugen's -m flag: dark or light).
# Selection writes ~/.local/state/hypr/color-mode and re-runs the
# wallpaper pipeline, which reads that file and passes -m to matugen, so
# the choice also survives later wallpaper changes and reboots. Picking
# the mode that is already active is a no-op.

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/hypr/color-mode"
RASI="$HOME/.config/hypr/rofi/schemetype.rasi"
PIPELINE="$HOME/.config/hypr/scripts/matugen-wallpaper"

prompt='Colour mode'

# Must match the values matugen accepts for -m (`matugen image --help`).
declare -a modes=(
    dark
    light
)
declare -a labels=(
    "Dark"
    "Light"
)

current="dark"
if [ -f "$STATE" ]; then
    read -r current < "$STATE" || true
fi

# A stale or hand-edited state file must never yield a row matugen would
# reject: fall back to dark instead of passing garbage downstream.
valid=""
for mode in "${modes[@]}"; do
    [ "$current" = "$mode" ] && valid=1
done
[ -z "$valid" ] && current="dark"

current_label=""
current_row=0
declare -a rows=()
for i in "${!modes[@]}"; do
    if [ "${modes[$i]}" = "$current" ]; then
        rows+=("●  ${labels[$i]}")
        current_label="${labels[$i]}"
        current_row="$i"
    else
        rows+=("○  ${labels[$i]}")
    fi
done

choice=$(printf '%s\n' "${rows[@]}" |
    rofi -dmenu \
        -p "$prompt" \
        -mesg "Current :: $current_label" \
        -selected-row "$current_row" \
        -markup-rows \
        -no-custom \
        -format i \
        -theme "$RASI")

case "$choice" in
    ''|*[!0-9]*) exit 0 ;;
esac
choice=$((choice))

mode="${modes[$choice]:-}"
[ -z "$mode" ] && exit 0
[ "$mode" = "$current" ] && exit 0

mkdir -p "$(dirname "$STATE")"
printf '%s\n' "$mode" > "$STATE"

# Run the pipeline directly instead of touching the wallpaper state file:
# that would wake wallpaper-watcher as well and replay the whole reload
# twice. matugen-wallpaper takes its own flock if one is already held.
exec "$PIPELINE"
