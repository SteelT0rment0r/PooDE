
#!/usr/bin/env bash

WALL_DIR="$HOME/Pictures/Wallpapers"
THUMB_DIR="$HOME/.cache/wallpaper-thumbs"
THEME="$HOME/.config/hypr/rofi/wallpaper.rasi"
THUMB_WIDTH=440
THUMB_HEIGHT=248
STATE_DIR="$HOME/.local/state/hypr"
STATE="$STATE_DIR/wallpaper"
mkdir -p "$STATE_DIR"

mkdir -p "$THUMB_DIR"

mapfile -d '' IMAGES < <(
    find "$WALL_DIR" -type f \
        \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \
        -o -iname '*.webp' -o -iname '*.gif' -o -iname '*.bmp' \) \
        -print0 | sort -z
)

if [ "${#IMAGES[@]}" -eq 0 ]; then
    rofi -e "No wallpapers found in $WALL_DIR"
    exit 1
fi

clean_name() {
    local base="${1##*/}"
    base="${base%.*}"
    base="${base//_/ }"
    base="${base//-/ }"
    printf '%s' "$base"
}

thumb_path() {
    local hash
    hash="$(printf '%s' "$1" | md5sum | cut -d' ' -f1)"
    printf '%s/%s.png' "$THUMB_DIR" "$hash"
}

ensure_thumb() {
    local img="$1"
    local thumb="$2"

    if [ ! -f "$thumb" ] || [ "$img" -nt "$thumb" ]; then
        magick "$img" -thumbnail "${THUMB_WIDTH}x${THUMB_HEIGHT}>" "$thumb"
    fi
}

build_menu() {
    local img thumb name i pad cols
    cols=3 # keep in sync with `columns` in wallpaper.rasi

    for img in "${IMAGES[@]}"; do
        thumb="$(thumb_path "$img")"
        ensure_thumb "$img" "$thumb"

        name="$(clean_name "$img")"

        printf '%s\0icon\x1f%s\n' "$name" "$thumb"
    done

    # Fill the empty cells of the last grid row with the first entries
    # again, so the list reads as one continuous loop. Thumbnails were
    # already generated by the loop above.
    pad=$(( (cols - ${#IMAGES[@]} % cols) % cols ))
    for ((i = 0; i < pad; i++)); do
        img="${IMAGES[$((i % ${#IMAGES[@]}))]}"
        name="$(clean_name "$img")"

        printf '%s\0icon\x1f%s\n' "$name" "$(thumb_path "$img")"
    done
}

reload_desktop() {
    # Reload Waybar in-place so Matugen colors are applied.
    pkill -SIGUSR2 waybar 2>/dev/null || true

}

apply_wallpaper() {
    local target="$1"
    local img

    for img in "${IMAGES[@]}"; do
        if [ "$(clean_name "$img")" = "$target" ]; then

            # Tell the theme watcher which wallpaper was selected. The
            # wallpaper-watcher picks this up and runs matugen-wallpaper,
            # which applies the image and the palette in one place;
            # calling it here as well used to run two reloads at once and
            # race the Waybar restart.
            printf 'wallpaper = %s\n' "$img" > "$STATE"

            return 0
        fi
    done

    return 1
}

apply_random() {
    local img="${IMAGES[RANDOM % ${#IMAGES[@]}]}"

    # Tell the theme watcher which wallpaper was selected (see apply_wallpaper);
    # matugen-wallpaper applies the image and palette.
    printf 'wallpaper = %s\n' "$img" > "$STATE"
}

HINT="↵ apply    Alt+r random    Alt+s shuffle    ␛ cancel    type to filter"

# Preselect the last applied wallpaper.
selected_row=0
if [ -f "$STATE" ]; then
    last_wallpaper="$(sed -n 's/^wallpaper = //p' "$STATE" | head -n 1)"
    for i in "${!IMAGES[@]}"; do
        if [ "${IMAGES[$i]}" = "$last_wallpaper" ]; then
            selected_row="$i"
            break
        fi
    done
fi

chosen="$(
    build_menu | rofi -dmenu \
        -theme "$THEME" \
        -p "Wallpaper" \
                -mesg "$HINT" \
        -selected-row "$selected_row" \
        -kb-custom-1 "Alt+r" \
        -kb-custom-2 "Alt+s"
)"

exit_code=$?

case "$exit_code" in
    10)
        apply_random
        ;;
    11)
        apply_random
        exec "$0"
        ;;
    0)
        [ -n "$chosen" ] && apply_wallpaper "$chosen"
        ;;
    *)
        exit 0
        ;;
esac

