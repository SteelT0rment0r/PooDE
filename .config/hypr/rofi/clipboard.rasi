/*****----- Rofi Clipboard -----*****/
/* cliphist history picker */

configuration {
    show-icons: false;
}

@import "~/.cache/desktop-theme/colors.rasi"
@import "shared/fonts.rasi"

window {
    transparency: "real";
    location: center;
    anchor: center;
    width: 820px;

    border: 0px solid;
    border-radius: 32px;
    border-color: @selected;
    background-color: @background;
}

mainbox {
    spacing: 10px;
    margin: 0px;
    padding: 30px;
    background-color: transparent;
    children: [ "inputbar", "listview" ];
}

/*****----- Input / hint bar -----*****/
inputbar {
    spacing: 10px;
    padding: 0px;
    background-color: transparent;
    text-color: @foreground;
    children: [ "prompt", "entry" ];
}

prompt {
    padding: 10px;
    border-radius: 32px;
    background-color: @background-alt;
    text-color: @neon-blue;
}

entry {
    padding: 10px 14px;
    border-radius: 32px;
    background-color: inherit;
    text-color: @neon-blue;
    cursor: text;
    placeholder: "Search…";
    placeholder-color: @muted;
    vertical-align: 0.5;
}

/*****----- History rows -----*****/
/* border-radius 1px on the container, 32px on the highlights: see the
   shared radius rule in shared/fonts.rasi. */
listview {
    columns: 1;
    lines: 10;
    cycle: true;
    dynamic: true;
    scrollbar: true;
    layout: vertical;
    fixed-height: false;
    fixed-columns: true;
    spacing: 5px;
    background-color: transparent;
    text-color: @foreground;
    cursor: default;
    border-radius: 1px;
}

element {
    spacing: 10px;
    margin: 0px;
    padding: 10px 14px;
    border-radius: 32px;
    background-color: transparent;
    text-color: @foreground;
    cursor: pointer;
}

element-text {
    font: "Maple Mono NF 12";
    background-color: transparent;
    text-color: inherit;
    highlight: inherit;
    cursor: inherit;
    vertical-align: 0.5;
    horizontal-align: 0.0;
}

element normal.normal,
element alternate.normal {
    background-color: @background;
    text-color: @foreground;
}

/* Rewritten per wallpaper by scripts/update-rofi-gradients.py. */
element selected.normal {
    background-image: linear-gradient(to right, #90B2CE, #8BAFCD, #86ADCD, #81AACC, #7CA8CB, #77A5CA, #72A3CA);
    text-color: @on-gradient;
}

scrollbar {
    handle-width: 2px;
    handle-color: @selected;
    border-radius: 32px;
    background-color: @background-alt;
}
